# ==============================================================================
# AQI Guardian - Environment Configuration
# ==============================================================================
# The Gemini API Key is strictly used by the server-side Next.js Route Handler
# at /api/ai-insight. It is NEVER exposed to the client or browser bundle.
#
# Get your free Gemini API key at: https://aistudio.google.com/
#
# Copy this file to .env.local and insert your key:
# GEMINI_API_KEY=your_actual_gemini_api_key_here
# ==============================================================================

GEMINI_API_KEY=
